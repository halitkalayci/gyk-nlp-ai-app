# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/sms_spam_db

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000

# Model Configuration
MODEL_PATH=model/sms_model.h5
TOKENIZER_PATH=model/tokenizer.pkl

# TensorFlow Configuration
TF_CPP_MIN_LOG_LEVEL=2

# Default User Configuration (for initial setup)
DEFAULT_USER_USERNAME=admin
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_FULLNAME=Administrator
DEFAULT_USER_PASSWORD=changeme123

# API Test Configuration
API_BASE_URL=http://localhost:8000
